# Copy to .env and adjust. All values have defaults in docker-compose.yml.
# Users are not configured here: create the first admin with
#   docker compose exec backend python -m app.manage create-admin
# Used to sign session cookies. CHANGE THIS in any shared deployment.
SECRET_KEY=change-me-please
# Seed a demo project on first start when the database is empty.
SEED_DEMO=true
# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5433
# Set to true when TestHarbor is served over HTTPS.
SECURE_COOKIES=false
# Database password (applied when the database volume is first created).
DB_PASSWORD=testharbor

# --- Production (docker-compose.prod.yml) ---
# Public domain name; Caddy gets an HTTPS certificate for it.
# DOMAIN=testharbor.example.com

# --- Test runner (optional; docs/runner.md) ---
# Runs autotests from a git branch you pick in TestHarbor. Start it with `make runner`.
# A TestHarbor API token for it: `make runner-token` prints a new one.
# RUNNER_TOKEN=th_...
# The project its tests belong to (the number in /projects/<id>/…).
# RUNNER_PROJECT=1
# The test repository, and an access token for it (Bitbucket: Repository settings › Access tokens, read access;
# GitHub: a fine-grained token with Contents: read). For a Bitbucket app password also set RUNNER_GIT_USER.
# RUNNER_REPO=https://bitbucket.org/team/qa-tests.git
# RUNNER_GIT_TOKEN=
# RUNNER_GIT_USER=
# Optional: the default branch, and the folder of testharbor.toml if it is not found by itself.
# RUNNER_BRANCH=main
# RUNNER_REPO_PATH=
# The runs' HTML reports (Playwright report, traces): the runner serves them on port 9323, bound to 127.0.0.1.
# To let the team open them, put it behind your proxy/VPN and set the address people use:
# RUNNER_REPORTS_URL=https://reports.testharbor.example.com
# RUNNER_REPORTS_BIND=0.0.0.0
