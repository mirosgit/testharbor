# Copy to .env and adjust. All values have defaults in docker-compose.yml.
# Users are not configured here: create the first admin with
#   docker compose exec backend python -m app.manage create-admin
# Used to sign session cookies. CHANGE THIS in any shared deployment.
SECRET_KEY=change-me-please
# Seed a demo project on first start when the database is empty.
SEED_DEMO=true
# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5433
# Set to true when TestHarbor is served over HTTPS.
SECURE_COOKIES=false
# Database password (applied when the database volume is first created).
DB_PASSWORD=testharbor

# --- Production (docker-compose.prod.yml) ---
# Public domain name; Caddy gets an HTTPS certificate for it.
# DOMAIN=testharbor.example.com
