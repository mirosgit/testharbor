# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically
# (ports 80 and 443 must be reachable from the internet, DNS must point here).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# JUnit uploads can be large; agents' HTML reports (traces, videos) even more
	# (the backend's MAX_REPORT_MB, 500 by default).
	@report path /api/runs/*/report
	@other not path /api/runs/*/report
	request_body @report {
		max_size 500MB
	}
	request_body @other {
		max_size 60MB
	}

	# Caddy replaces any client-sent X-Forwarded-For with the real client IP,
	# which the backend uses for login rate limiting.
	reverse_proxy frontend:3000
}
